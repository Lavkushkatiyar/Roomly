# Existing PostgreSQL database. Use a hostname reachable from containers.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE_NAME

# Gnani AI account
GNANI_API_KEY_ID=replace-with-your-gnani-key-id

# Reasoning provider: ollama or openrouter
REASONING_PROVIDER=ollama
REASONING_MODEL=qwen3:8b

# For Ollama running on the Docker host
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Required only when REASONING_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Keep empty when the frontend and backend use the same origin.
VITE_API_BASE_URL=
